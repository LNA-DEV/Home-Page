{{- /* Deprecate site.Author.email in favor of site.Params.author.email */}}
{{- $authorEmail := "" }}
{{- with site.Params.author }}
  {{- if reflect.IsMap . }}
    {{- with .email }}
      {{- $authorEmail = . }}
    {{- end }}
  {{- end }}
{{- else }}
  {{- with site.Author.email }}
    {{- $authorEmail = . }}
    {{- warnf "The author key in site configuration is deprecated. Use params.author.email instead." }}
  {{- end }}
{{- end }}

{{- /* Deprecate site.Author.name in favor of site.Params.author.name */}}
{{- $authorName := "" }}
{{- with site.Params.author }}
  {{- if reflect.IsMap . }}
    {{- with .name }}
      {{- $authorName = . }}
    {{- end }}
  {{- else }}
    {{- $authorName  = . }}
  {{- end }}
{{- else }}
  {{- with site.Author.name }}
    {{- $authorName = . }}
    {{- warnf "The author key in site configuration is deprecated. Use params.author.name instead." }}
  {{- end }}
{{- end }}

{{- $pctx := . }}
{{- if .IsHome }}{{ $pctx = site }}{{ end }}
{{- $pages := slice }}
{{- if or $.IsHome $.IsSection }}
{{- $pages = $pctx.RegularPages }}
{{- else }}
{{- $pages = $pctx.Pages }}
{{- end }}
{{- $limit := site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
{{- $pages = $pages | first $limit }}
{{- end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- if eq .Section "gallery" }}

<rss version="2.0" xmlns:media="http://search.yahoo.com/mrss/" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq  .Title  .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{.}} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content {{ if ne  .Title  .Site.Title }}{{ with .Title }}in {{.}} {{ end }}{{ end }}on {{ .Site.Title }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ site.Language.Locale }}</language>{{ with site.Params.author.email }}
    <managingEditor>{{.}}{{ with $authorName }} ({{ . }}){{ end }}</managingEditor>{{ end }}{{ with $authorEmail }}
    <webMaster>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</webMaster>{{ end }}{{ with .Site.Copyright }}
    <copyright>{{.}}</copyright>{{end}}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" -}}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end -}}

    {{- $allImages := partialCached "gallery-images.html" . -}}
    {{- if $allImages -}}
    {{- $metaAll := partialCached "gallery-meta.html" . -}}
    {{- $lookup  := $metaAll.bySrc -}}
    {{- range $allImages -}}
    {{- $meta := index $lookup (path.Base .Name) -}}
    {{- if and $meta (ne ($meta.section | default "") "archive") -}}

    <item>
      <title>{{ path.Base .Name }}</title>
      <link>{{ $.Permalink }}#{{ $meta.id }}</link>
      {{- with .Meta }}{{- with .Date }}
      <pubDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- end }}{{- end }}
      {{- with $authorEmail }}<author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>{{ end }}
      <guid isPermaLink="false">{{ $meta.id }}</guid>
      {{ $full := .Filter (slice images.AutoOrient (images.Process "fit 1600x1600")) }}
      <media:content url="{{ $full.Permalink }}" type="image/jpeg"/>
      <description>
        <img src="{{ $full.Permalink }}" alt="{{ with $meta.alt }}{{ . }}{{ else }}{{ partial "image-alt.html" . }}{{ end }}"/>
        {{- if ne .Title (path.Base .Name) -}}
        <p> {{ .Title }} </p>
        {{ end }}
      </description>
      {{ range $meta.tags }}
      <category>{{ . }}</category>
      {{- end }}
      {{- if not $meta.tags }}
      {{- $keywords := "" }}
      {{- with .Meta }}
      {{- with .Exif }}
      {{- with .subject }}{{ $keywords = . }}{{ end }}
      {{- if not $keywords }}{{ with .Subject }}{{ $keywords = . }}{{ end }}{{ end }}
      {{- if not $keywords }}{{ with .Keywords }}{{ $keywords = . }}{{ end }}{{ end }}
      {{- end }}
      {{- if not $keywords }}{{ with .XMP }}{{ with .Subject }}{{ $keywords = delimit . ", " }}{{ end }}{{ end }}{{ end }}
      {{- end }}
      {{- with $keywords }}
        {{- range split . ", " }}
          {{- if . }}
        <category>{{ . }}</category>
          {{- end }}
        {{- end }}
      {{- end }}
      {{- end }}
    </item>
    {{- end -}}
    {{- end -}}
    {{- end }}
    
  </channel>
</rss>

{{- else }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if eq .Title site.Title }}{{ site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content {{ if ne .Title site.Title }}{{ with .Title }}in {{ . }} {{ end }}{{ end }}on {{ site.Title }}</description>
    {{- with site.Params.images }}
    <image>
      <title>{{ site.Title }}</title>
      <url>{{ index . 0 | absURL }}</url>
      <link>{{ index . 0 | absURL }}</link>
    </image>
    {{- end }}
    <generator>Hugo -- {{ hugo.Version }}</generator>
    <language>{{ site.Language.Locale }}</language>{{ with $authorEmail }}
    <managingEditor>{{.}}{{ with $authorName }} ({{ . }}){{ end }}</managingEditor>{{ end }}{{ with $authorEmail }}
    <webMaster>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</webMaster>{{ end }}{{ with site.Copyright }}
    <copyright>{{ . | markdownify | plainify | strings.TrimPrefix "© " }}</copyright>{{ end }}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    {{- if and (ne .Layout `search`) (ne .Layout `archives`) (ne .Section "gallery") }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with $authorEmail }}<author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>{{ end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ with .Description | html }}{{ . }}{{ else }}{{ .Summary | html }}{{ end -}}</description>
      {{- if and site.Params.ShowFullTextinRSS .Content }}
      {{- /* The feed ships the page's own HTML, which is written for this site's
             stylesheet and for a browser that knows the origin. Neither holds in a
             feed reader, so the markup is adjusted here rather than by rendering the
             content a second time per output format: every image in a post body goes
             through responsive-image.html or gallery-image-figure.html, and both
             already point `src` at the largest variant <= 720px — which is exactly
             what a feed wants. Dropping the responsive attributes therefore leaves
             the right image behind, for all six image shortcodes at once, without a
             single .rss.xml template.

             1. srcset/sizes out. `sizes` describes a slot that only exists on this
                site: a floated {{< galleryImage >}} claims "280px", so a reader with
                a wide window picks the 480w candidate and upscales it to the panel
                width. Removing both leaves `src` (the 720px variant) and, as a side
                effect, removes the only comma-separated URL lists — which is what
                keeps step 2 a single, simple rewrite.
             2. Root-relative URLs out. This is the bug this block exists for: RSS 2.0
                defines no base URL for HTML inside content:encoded and xml:base is
                not honoured reliably, so a reader resolves `/images/gallery/…`
                against its own origin and the image — or link — is simply lost. It
                hit every image in every post, and every hand-written link in the
                prose too. Built from site.BaseURL so deploy.sh's second pass emits
                the onion host. Protocol-relative `//host` URLs are left alone; the
                Mastodon and PeerTube embeds use them.
             3. schema.org microdata out. No feed consumer reads it, sanitizers drop
                it anyway, and it is ~1.4 kB per image. Only elements carrying
                `itemprop` are matched, so nothing an author wrote in the content is
                touched; attribution stays with the channel <copyright> and the
                caption.

             The gallery branch above needs none of this — it builds its own markup
             and already uses absolute permalinks. */ -}}
      {{- $base := strings.TrimSuffix "/" site.BaseURL -}}
      {{- $c := .Content -}}
      {{- $c = replaceRE `\s+(?:srcset|sizes)="[^"]*"` "" $c -}}
      {{- $c = replaceRE `(src|href|poster)="/([^/])` (printf `${1}="%s/${2}` $base) $c -}}
      {{- $c = replaceRE `(src|href|poster)="/"` (printf `${1}="%s/"` $base) $c -}}
      {{- $c = replaceRE `\s*<(?:meta|link) itemprop="[^"]*"[^>]*>` "" $c -}}
      {{- $c = replaceRE `\s*<span itemprop="creator"[^>]*>\s*</span>` "" $c -}}
      <content:encoded>{{ (printf "<![CDATA[%s]]>" $c) | safeHTML }}</content:encoded>
      {{- end }}
    </item>
    {{- end }}
    {{- end }}
  </channel>
</rss>
{{- end }}