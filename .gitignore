node_modules
# Local credentials (e.g. STEAM_API_KEY / STEAM_ID for scripts/sync-steam.py).
.env
.env.*
/public
/resources/_gen/
# Gallery photos live outside the repo; mounted in via config/_default/module.yaml,
# which holds this machine's absolute path to the photo store and is therefore local
# only (copy config/_default/module.yaml.example — see CLAUDE.md "Build / Deploy").
/config/_default/module.yaml
# Inert leftover: the old `gallery-photos` symlink. Hugo stopped following symlinked
# mount sources in 0.163.1 (CVE-2026-58403 fix), which is why the mount moved to an
# absolute path above. Still ignored so a stale symlink does not show up as untracked.
/gallery-photos
.inbox/**
.env
scripts/__pycache__/**
# Large downloadable archives (photo packs etc.). Kept out of git — GitHub caps
# files at 100 MB — but still deployed: `hugo` copies static/ into public/ and
# deploy.sh rsyncs from this machine. Same model as /gallery-photos above.
/static/downloads/
konzepte/**
konzept/rss-galeriebilder.md
konzept/test-feed.py
# Test suite (docs/concepts/testing.md). `.test-site/` is the build under test —
# a second full copy of the site, ~8 GB, rewritten by every run. It is deliberately
# NOT public/, so the deploy artefact is only ever written by deploy.sh.
/.test-site/
/.test-site-verify/
/playwright-report/
/test-results/
tests/py/__pycache__/**
